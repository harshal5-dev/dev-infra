# File: databases/postgres/secret.yaml.example
# Copy this file to secret.yaml and set your local credentials:
# cp databases/postgres/secret.yaml.example databases/postgres/secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: database
type: Opaque
stringData:
  POSTGRES_USER: "<YOUR_POSTGRES_USER>"
  POSTGRES_PASSWORD: "<YOUR_POSTGRES_PASSWORD>"
  POSTGRES_DB: "postgres"
